class NotBuilt(Exception):
    """Nothing of this step exists yet."""


class Result:
    def __init__(self):
        self.lines = []

    def ok(self, text: str) -> None:
        self.lines.append(("ok", text))

    def bad(self, text: str) -> None:
        self.lines.append(("NOT", text))

    def note(self, text: str) -> None:
        self.lines.append(("note", text))

    def expect(self, condition: bool, good: str, wrong: str) -> bool:
        (self.ok if condition else self.bad)(good if condition else wrong)
        return condition

    @property
    def passed(self) -> bool:
        return all(kind != "NOT" for kind, _ in self.lines)


def env_of(container: dict) -> dict:
