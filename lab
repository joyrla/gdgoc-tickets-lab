def skip(step: str) -> None:
    if not step.isdigit() or int(step) not in SKIPS:
        die(f"Steps ./lab skip can build: {', '.join(map(str, SKIPS))}")
    n = int(step)
    cloud = cloud_from_settings()
    if n == 14:
        skip_repo()
    elif n == 15:
        skip_trust(cloud)
    else:
        if n in (5, 8, 11, 12):
            need(cloud.exists("iam", "service-accounts", "describe", cloud.sa("web")), "Step 3 first: ./lab base")
        if n in (8, 11):
            need(bool(cloud.run_api("services/ticket-worker")), "Step 6 first: ./lab workers")
        if n == 11:
            need(
                cloud.exists("firestore", "databases", "describe", "--database=(default)"),
                "Step 2 first (or ./lab skip 2)",
            )
        if n in (5, 12):
            need(images_ready(cloud), "The images are not ready yet: ./lab images")
        print(f"Building step {n} with Terraform.")
        apply(cloud, SKIPS[n])
    record_skip(n)
    print(f"Step {n} is built and marked as skipped. Read what it built in the sheet, then go on.")


def skip_repo() -> None:
    login = gh("api", "user", "-q", ".login") or die("Sign in to GitHub first: gh auth login --web --scopes workflow")
    repo = f"{login}/{COPY_NAME}"
    if not gh("api", f"repos/{repo}", "-q", ".id"):
        sh(["gh", "repo", "create", repo, "--private", "--template", TEMPLATE])
    elif not made_from_template(repo):
        die(
            f"{repo} already exists and was not made from {TEMPLATE}. Pick another name: LAB_COPY_NAME=NAME ./lab skip 14"
        )
    target = Path.home() / COPY_NAME
    if not target.exists():
        for _ in range(10):  # GitHub copies a template in the background
            if subprocess.run(["gh", "repo", "clone", repo, str(target)], capture_output=True).returncode == 0:
                break
            time.sleep(3)
        else:
            die(f"Could not clone {repo} yet. Try: gh repo clone {repo} ~/{COPY_NAME}")
    print(f"Your copy is {repo}, in ~/{COPY_NAME}. From now on work there: cd ~/{COPY_NAME}")


def skip_trust(cloud: Cloud) -> None:
    repo = own_repo() or die("Step 14 first: your copy of the repository (or ./lab skip 14).")
    need(bool(cloud.run_api("services/ticket-worker")), "Step 6 first: ./lab workers")
    need(bool(cloud.run_api("services/web")), "Step 5 first (or ./lab skip 5)")
    repo_id = gh("api", f"repos/{repo}", "-q", ".id")
    values = settings()
    values["github_repo_id"] = repo_id
    write_tfvars(values)
    print("Building step 15 with Terraform.")
    apply(cloud, SKIPS[15])
    for name, value in (
        ("GCP_PROJECT_ID", cloud.project),
        ("WIF_PROVIDER", cloud.provider),
        ("DEPLOYER_SA", cloud.sa("deployer")),
    ):
        sh(["gh", "variable", "set", name, "--repo", repo, "--body", value], capture=True)
        print(f"  GitHub variable {name} set")
    sh(["gh", "workflow", "run", "sign-in-test.yml", "--repo", repo, "--ref", "main"], capture=True)
    print("  the sign-in test is running: Actions → Sign-in test")


def pause() -> None:
    cloud = cloud_from_settings()
    for job in housekeeping_schedulers(cloud):
        name = job["name"].split("/")[-1]
        sh(
            [
                "gcloud",
                "scheduler",
                "jobs",
                "pause",
                name,
                "--location",
                cloud.region,
                "--project",
                cloud.project,
                "--quiet",
            ]
        )
        print(f"The Scheduler job {name} is paused: housekeeping stops running every 5 minutes.")
    repo = own_repo()
    if repo:
        sh(["gh", "variable", "set", "DEPLOY_ENABLED", "--repo", repo, "--body", "false"], capture=True)
        print(f"Deploys from {repo} are off (DEPLOY_ENABLED=false).")
    print("Everything else stays for the IaC session. To resume: Cloud Scheduler → the job → Resume.")


def down() -> None:
    cloud = cloud_from_settings()
    answer = input(f"This deletes everything the lab made in {cloud.project}. Type the project ID to continue: ")
    if answer.strip() != cloud.project:
        die("Stopped. Nothing was changed.")
    values = settings()
    values["lab_parts"] = PARTS
    write_tfvars(values)
    env = terraform_env()
    ensure_terraform(env)
    print("Finding what was made by hand, so Terraform can delete it too.")
    adopt(cloud, PARTS, env)
    for attempt in range(1, 4):
        # cleanup.sh asks for "yes" before destroying, and once more if Firestore is protected
        done = subprocess.run([str(INFRA / "cleanup.sh")], input="yes\nyes\n", text=True, env=env)
        if done.returncode == 0:
            break
        if attempt == 3:
            die("Teardown kept failing. Read the error above, then run ./lab down again.")
        print("Teardown stopped partway. Trying the rest again in 30 seconds.")
        time.sleep(30)
    repo = own_repo()
    if repo:
        gh("variable", "delete", "DEPLOY_ENABLED", "--repo", repo)
        print(f"Deploys from {repo} are off. Delete the repository on GitHub if you no longer need it.")


# ---------------------------------------------------------------- main


def main(argv: list) -> None:
    os.environ["PATH"] = f"{Path.home() / 'bin'}:{Path.home() / '.local/bin'}:{os.environ['PATH']}"
    command, args = (argv[0], argv[1:]) if argv else ("", [])
    if command:
        # Every command, not only Terraform's: in a folder set up for something else (production),
        # its GitHub repository is not the student's copy, and ./lab pause would switch off its deploys
        link_settings()
    if command == "start" and len(args) == 1:
        start(args[0])
    elif command == "images":
        images()
    elif command in SHORTCUTS and not args:
        shortcut(command)
    elif command == "iam":
        iam()
    elif command == "env":
        show_env(args[0] if args else "")
    elif command == "code":
        code()
    elif command == "check":
        check(args)
    elif command == "skip" and len(args) == 1:
        skip(args[0])
    elif command == "pause":
        pause()
    elif command == "down":
        down()
    else:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
