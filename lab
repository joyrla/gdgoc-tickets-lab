def run_check(cloud: Cloud, step: int) -> tuple:
    result = Result()
    try:
        CHECKS[step](cloud, result)
        status = "ok" if result.passed else "NOT"
    except NotBuilt as reason:
        result.lines.append(("-", str(reason)))
        status = "-"
    if str(step) in skipped():
        status += " (skipped)"
    return status, result.lines


def check(args: list) -> None:
    cloud = cloud_from_settings()
    report = "--report" in args
    steps = [int(a) for a in args if a.isdigit()] or list(CHECKS)
    unknown = [s for s in steps if s not in CHECKS]
    if unknown:
        die(f"No check for step {unknown[0]}. Steps with a check: {', '.join(map(str, CHECKS))}")
    out = []
    if report:
        out.append(f"Cloud Ticketing lab report, {datetime.now().isoformat(timespec='minutes')}")
        out.append(f"project {cloud.project} (number {cloud.number}), {cloud.region}, admin {cloud.admin}")
        repo = own_repo()
        out.append(f"GitHub {repo or '-'}")
        out.append(f"skipped steps: {', '.join(sorted(skipped(), key=int)) or 'none'}")
        out.append("")
    failed = False
    for step in steps:
        status, lines = run_check(cloud, step)
        failed |= status.startswith("NOT")
        out.append(f"step {step:<3} {STEP_NAMES[step]:<40} {status}")
        if len(steps) == 1 or report or status.startswith("NOT"):
            out += [f"  {kind:<5} {text}" for kind, text in lines]
    if report:
        web = (
            cloud.gcloud("run", "revisions", "list", "--service", "web", "--region", cloud.region, "--limit", "10")
            or []
        )
        out.append("")
        out.append("web revisions: " + ", ".join(r["metadata"]["name"] for r in web))
        REPORT.write_text("\n".join(out) + "\n")
        out.append(f"\nSaved to {REPORT}. Submit that file.")
    print("\n".join(out))
    sys.exit(1 if failed and not report else 0)


