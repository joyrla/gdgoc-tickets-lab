def adopt(cloud: Cloud, parts: list, env: dict) -> None:
    """Hand Terraform the pieces of these parts that someone already made, so it doesn't make them twice."""
    state = set((terraform("state", "list", env=env).stdout or "").split())
    for part in parts:
        for address, import_id in adoptable(cloud, part):
            if address in state:
                continue
            found = import_id()
            if not found:
                continue
            print(f"  found {address.split('.')[-1]} already made; Terraform takes it over")
            done = terraform("import", "-input=false", "-no-color", address, found, env=env)
            if done.returncode:
                die(f"Could not take over {address}:\n{done.stdout[-1500:]}{done.stderr[-1500:]}")


def apply(cloud: Cloud, parts: list) -> None:
    """Turn these parts on in terraform.tfvars, take over what exists, and apply."""
    values = settings()
    parts = add_parts(values, parts)
    # A subscription Terraform owns (step 4 skipped) that the student switched to Push by
    # hand (step 8) stays Push: Terraform takes the change over instead of undoing it
    if "topics" in parts and "push" not in parts:
        found = cloud.gcloud("pubsub", "subscriptions", "describe", "ticket-worker") or {}
        if found.get("pushConfig", {}).get("pushEndpoint"):
            parts = add_parts(values, parts + ["push"])
    values["lab_parts"] = parts
    write_tfvars(values)
    env = terraform_env()
    ensure_terraform(env)
    adopt(cloud, parts, env)
    log = HOME / "apply.log"
    for attempt in range(1, 5):
        plan = terraform("plan", "-input=false", "-no-color", "-out=lab.tfplan", env=env)
        done = plan
        if plan.returncode == 0:
            done = terraform("apply", "-input=false", "-no-color", "lab.tfplan", env=env)
        output = (plan.stdout or "") + (plan.stderr or "") + (done.stdout or "") + (done.stderr or "")
        log.write_text(output)
        (INFRA / "lab.tfplan").unlink(missing_ok=True)
        if done.returncode == 0:
            return
        if not RETRYABLE.search(output) or attempt == 4:
            print("\n".join(output.strip().splitlines()[-25:]), file=sys.stderr)
            die(f"Stopped on the error above (full output: {log}).")
        print(f"Google Cloud is not ready yet. Trying again in a minute ({attempt} of 3).")
        time.sleep(60)


# ---------------------------------------------------------------- commands: setup


def tools() -> None:
    os.environ["PATH"] = f"{Path.home() / 'bin'}:{Path.home() / '.local/bin'}:{os.environ['PATH']}"
    in_cloud_shell = platform.system() == "Linux" and platform.machine() == "x86_64"
    version = (
        subprocess.run(["terraform", "version"], capture_output=True, text=True).stdout if has("terraform") else ""
    )
    if in_cloud_shell and (TERRAFORM_VERSION not in version or not has("locust")):
        sh([str(REPO / "scripts/setup-cloudshell.sh")])
    elif not has("terraform"):
        die(f"Install Terraform {TERRAFORM_VERSION} first (Cloud Shell gets it automatically).")


def has(tool: str) -> bool:
    return subprocess.run(["which", tool], capture_output=True).returncode == 0


def start(project: str) -> None:
    tools()
    account = sh(["gcloud", "config", "get-value", "account"], capture=True, check=False).strip()
    if not account:
        die("gcloud is not signed in. Run: gcloud auth login")
    cloud = Cloud(project)
    if not cloud.gcloud("projects", "describe", project, project=False):
        die(f"{account} cannot see project {project}. Check the ID in the Console's project picker.")
    billing = cloud.gcloud("billing", "projects", "describe", project, project=False) or {}
    if not billing.get("billingEnabled"):
        die(f"Project {project} has no billing account linked. Link one under Billing in the Console (step 0).")
    sh(["gcloud", "config", "set", "project", project, "--quiet"], capture=True)

    values = read_tfvars()
    if values.get("project_id") and values["project_id"] != project:
        die(f"The lab is set up for {values['project_id']}. To start over in {project}: ./lab down first.")
    if not values:
        values = {
            "project_id": project,
            "github_repo_id": "0",  # your copy's ID, set in step 15
            "admin_emails": [account],
            "lab_image_tag": "lab",
            "lab_parts": ["start"],
        }
        write_tfvars(values)

    # Cloud Shell starts with no git identity, and git commit refuses to run without one
    for key, value in (("user.email", account), ("user.name", account.split("@")[0])):
        if subprocess.run(["git", "config", "--global", key], capture_output=True).returncode:
            sh(["git", "config", "--global", key, value])
    if subprocess.run(["gh", "auth", "status"], capture_output=True).returncode:
        sh(
            [
                "gh",
                "auth",
                "login",
                "--hostname",
                "github.com",
                "--git-protocol",
                "https",
                "--web",
                "--scopes",
                "workflow",
            ]
        )
    sh(["gh", "auth", "setup-git"], check=False)

    print("Turning on the APIs and creating the image registry. This takes about 3 minutes.")
    apply(cloud, ["start"])
    if images_ready(cloud):
        print("The images are already in the registry.")
    else:
        log = HOME / "images.log"
        with open(log, "w") as out:
            subprocess.Popen(
                [sys.executable, __file__, "images"],
                cwd=REPO,
                stdout=out,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
        print(f"Building the four images in the background (about 5 minutes; progress: tail -f {log}).")
    print()
    print("Done. Next: step 2, the Firestore database, in the Console.")


