def images() -> None:
    """Build the four images in Cloud Shell and push them, before GitHub Actions is connected."""
    cloud = cloud_from_settings()
    if not has("docker"):
        die("docker is missing. Cloud Shell has it; run ./lab images there.")
    sh(["gcloud", "auth", "configure-docker", f"{cloud.region}-docker.pkg.dev", "--quiet"], capture=True)
    for name in IMAGES:
        tag = f"{cloud.registry}/{name}:lab"
        print(f"building {tag}", flush=True)
        sh(["docker", "build", "--quiet", "--target", name, "-t", tag, "."], cwd=REPO)
        sh(["docker", "push", "--quiet", tag])
    print("images ready", flush=True)


